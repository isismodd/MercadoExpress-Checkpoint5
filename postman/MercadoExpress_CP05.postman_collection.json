                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/mercado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mercado"
              ]
            }
          }
        },
        {
          "name": "3. Criar compra (aprovada)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{userProd}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{passProd}}",
                  "type": "string"
                }
              ]
            },
