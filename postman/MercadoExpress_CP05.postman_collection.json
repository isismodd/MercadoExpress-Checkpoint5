{
  "info": {
    "name": "MercadoExpress CP05 - Parte 2 (Render + Local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://mercadoexpress-checkpoint5.onrender.com"
    },
    {
      "key": "userProd",
      "value": "admin"
    },
    {
      "key": "passProd",
      "value": "SENHA_DO_ADMIN_NO_RENDER"
    },
    {
      "key": "baseUrlLocal",
      "value": "http://localhost:8082"
    },
    {
      "key": "userLocal",
      "value": "admin"
    },
    {
      "key": "passLocal",
      "value": "admin123"
    },
    {
      "key": "emailCliente",
      "value": "SEU_EMAIL@gmail.com"
    },
    {
      "key": "produtoId",
      "value": "1"
    },
    {
      "key": "compraId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "A) Produção (Render) - sem envio de e-mail",
      "item": [
        {
          "name": "1. Criar produto (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{userProd}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{passProd}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/mercado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mercado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Meia Esportiva\",\n  \"tipo\": \"Vestuário\",\n  \"setor\": \"Meias\",\n  \"tamanho\": \"M\",\n  \"preco\": 19.9,\n  \"custo\": 8.5,\n  \"estoque\": 50\n}"
            }
          }
        },
        {
          "name": "2. Listar produtos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
