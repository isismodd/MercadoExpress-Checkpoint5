              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "compras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteNome\": \"Maria Silva\",\n  \"clienteEmail\": \"{{emailCliente}}\",\n  \"numeroCartao\": \"4111111111111111\",\n  \"itens\": [\n    { \"produtoId\": {{produtoId}}, \"quantidade\": 2 }\n  ]\n}"
            }
          }
        },
        {
          "name": "4. Criar compra (cartão final 0000 = recusada)",
